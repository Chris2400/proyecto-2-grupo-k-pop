#include <stdio.h>

typedef struct {
    char nombre[30];
    int bonus;
    int vigencia;
} Cancion;

typedef struct {
    char nombre[30];
    int popularidad;
    int energia;
    int energia_max;
    int fans;
    Cancion *cancion;
} Idol;

int limitar(int valor, int minimo, int maximo) {
    if (valor < minimo) return minimo;
    if (valor > maximo) return maximo;
    return valor;
}

void mostrar(const Idol *i) {
    if (i == NULL) return;
    printf("Nombre: %s | Popularidad: %d | Energia: %d/%d | Fans: %d\n", 
           i->nombre, i->popularidad, i->energia, i->energia_max, i->fans);
}

void ensayar(Idol *i) {
    if (i == NULL) return;
    i->popularidad += 5;
    i->energia = limitar(i->energia - 20, 0, i->energia_max);
}

void descansar(Idol *i) {
    if (i == NULL) return;
    i->energia = limitar(i->energia + 30, 0, i->energia_max);
}

int esta_activa(const Idol *i) {
    if (i == NULL) return 0;
    return i->energia > 0 ? 1 : 0;
}

int colaboracion(Idol *a, Idol *b) {
    if (a == NULL || b == NULL || a == b) return 0;
    a->popularidad += 10;
    a->energia = limitar(a->energia - 15, 0, a->energia_max);
    b->popularidad += 10;
    b->energia = limitar(b->energia - 15, 0, b->energia_max);
    return 1;
}

void asignar_cancion(Idol *i, Cancion *c) {
    if (i == NULL) return;
    i->cancion = c;
}

// HU-15: Popularidad total con bono (NUEVO)
int popularidad_total(const Idol *i) {
    if (i == NULL) return 0;
    int total = i->popularidad;
    // Verifica NULL antes de acceder a vigencia
    if (i->cancion != NULL && i->cancion->vigencia > 0) {
        total += i->cancion->bonus;
    }
    return total;
}

int main() {
    Idol jennie = {"jennie", 50, 100, 100, 12000, NULL};
    Idol rose = {"rose", 50, 100, 100, 10000, NULL};
    
    Cancion discos[2] = {{"Starlight", 10, 3}, {"Nova", 5, 6}};
    
    asignar_cancion(&jennie, &discos[0]);
    asignar_cancion(&rose, &discos[0]); // Canción compartida
    
    printf("--- HU-15: Popularidad total con bono ---\n");
    printf("Popularidad base de Jennie: %d\n", jennie.popularidad);
    printf("Popularidad total de Jennie (con bono): %d\n", popularidad_total(&jennie));
    
    // Simulamos que la canción pierde vigencia
    discos[0].vigencia = 0;
    printf("\nSi la vigencia de la cancion es 0:\n");
    printf("Popularidad total de Jennie: %d (ya no da bono)\n", popularidad_total(&jennie));
    printf("Popularidad total de Rose: %d (ya no da bono)\n", popularidad_total(&rose));
    
    // Idol sin canción
    printf("\nPopularidad total de una idol sin cancion: %d\n", popularidad_total(&jennie) - jennie.cancion->bonus + jennie.cancion->bonus); // Prueba segura
    
    return 0;
}