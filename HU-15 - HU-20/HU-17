#include <stdio.h>

typedef struct {
    char nombre[30];
    int bonus;
    int vigencia;
} Cancion;

typedef struct {
    char nombre[30];
    int popularidad;
    int energia;
    int energia_max;
    int fans;
    Cancion *cancion;
} Idol;

typedef struct {
    char nombre[30];
    Idol miembros[4];
    int n;
    Idol *lider;
} Grupo;

int limitar(int valor, int minimo, int maximo) {
    if (valor < minimo) return minimo;
    if (valor > maximo) return maximo;
    return valor;
}

void mostrar(const Idol *i) {
    if (i == NULL) return;
    printf("Nombre: %s | Popularidad: %d | Energia: %d/%d | Fans: %d\n", 
           i->nombre, i->popularidad, i->energia, i->energia_max, i->fans);
}

void ensayar(Idol *i) {
    if (i == NULL) return;
    i->popularidad += 5;
    i->energia = limitar(i->energia - 20, 0, i->energia_max);
}

void descansar(Idol *i) {
    if (i == NULL) return;
    i->energia = limitar(i->energia + 30, 0, i->energia_max);
}

int esta_activa(const Idol *i) {
    if (i == NULL) return 0;
    return i->energia > 0 ? 1 : 0;
}

int colaboracion(Idol *a, Idol *b) {
    if (a == NULL || b == NULL || a == b) return 0;
    a->popularidad += 10;
    a->energia = limitar(a->energia - 15, 0, a->energia_max);
    b->popularidad += 10;
    b->energia = limitar(b->energia - 15, 0, b->energia_max);
    return 1;
}

void asignar_cancion(Idol *i, Cancion *c) {
    if (i == NULL) return;
    i->cancion = c;
}

int popularidad_total(const Idol *i) {
    if (i == NULL) return 0;
    int total = i->popularidad;
    if (i->cancion != NULL && i->cancion->vigencia > 0) {
        total += i->cancion->bonus;
    }
    return total;
}

// HU-17: Cambiar líder (NUEVO)
int cambiar_lider(Grupo *g, Idol *nueva) {
    if (g == NULL || nueva == NULL) return 0;
    
    // Compara direcciones de memoria, no nombres
    for (int i = 0; i < g->n; i++) {
        if (&g->miembros[i] == nueva) {
            g->lider = nueva;
            return 1;
        }
    }
    return 0; // No pertenece al grupo
}

int main() {
    Idol jennie = {"jennie", 50, 100, 100, 12000, NULL};
    Idol rose = {"rose", 50, 100, 100, 10000, NULL};
    Idol lisa = {"lisa", 50, 100, 100, 15000, NULL};
    Idol ajena = {"ajena", 50, 100, 100, 5000, NULL}; // Idol que NO está en el grupo
    
    Cancion discos[2] = {{"Starlight", 10, 3}, {"Nova", 5, 6}};
    asignar_cancion(&jennie, &discos[0]);
    
    Grupo g = {"Lumina", {jennie, rose, lisa}, 3, NULL};
    
    printf("--- HU-17: Cambiar lider ---\n");
    printf("Lider actual: %s\n", g.lider == NULL ? "Ninguna" : g.lider->nombre);
    
    // Prueba: Cambiar a Jennie (que sí está en el grupo)
    int resultado = cambiar_lider(&g, &g.miembros[0]);
    printf("\nIntentando cambiar a Jennie (miembro 0)...\n");
    printf("Resultado: %d\n", resultado);
    printf("Nueva lider: %s\n", g.lider == NULL ? "Ninguna" : g.lider->nombre);
    if (g.lider != NULL) {
        printf("Fans de la lider: %d\n", g.lider->fans);
    }
    
    // Prueba: Intentar cambiar a una idol ajena
    printf("\nIntentando cambiar a una idol AJENA al grupo...\n");
    resultado = cambiar_lider(&g, &ajena);
    printf("Resultado (debe ser 0): %d\n", resultado);
    printf("Lider sigue siendo: %s\n", g.lider == NULL ? "Ninguna" : g.lider->nombre);
    
    return 0;
}