#include <stdio.h>

typedef struct {
    char nombre[30];
    int popularidad;
    int energia;
    int energia_max;
    int fans;
} Idol;

int limitar(int valor, int minimo, int maximo) {
    if (valor < minimo) return minimo;
    if (valor > maximo) return maximo;
    return valor;
}

void mostrar(const Idol *i) {
    if (i == NULL) return;
    printf("Nombre: %s | Popularidad: %d | Energia: %d/%d | Fans: %d\n", 
           i->nombre, i->popularidad, i->energia, i->energia_max, i->fans);
}

void ensayar(Idol *i) {
    if (i == NULL) return;
    i->popularidad += 5;
    i->energia = limitar(i->energia - 20, 0, i->energia_max);
}

void descansar(Idol *i) {
    if (i == NULL) return;
    i->energia = limitar(i->energia + 30, 0, i->energia_max);
}

int esta_activa(const Idol *i) {
    if (i == NULL) return 0;
    return i->energia > 0 ? 1 : 0;
}

void ensayar_por_valor(Idol i) {
    i.popularidad += 100;
    i.energia -= 50;
    printf("Dentro de ensayar_por_valor, la copia tiene popularidad %d\n", i.popularidad);
}

// HU-09: Colaboración segura (NUEVO)
int colaboracion(Idol *a, Idol *b) {
    // Verificación de NULL y apuntadores repetidos ANTES de usar ->
    if (a == NULL || b == NULL || a == b) return 0;
    
    a->popularidad += 10;
    a->energia = limitar(a->energia - 15, 0, a->energia_max);
    
    b->popularidad += 10;
    b->energia = limitar(b->energia - 15, 0, b->energia_max);
    
    printf("Colaboracion exitosa entre %s y %s.\n", a->nombre, b->nombre);
    return 1;
}

int main() {
    Idol jennie = {"jennie", 50, 100, 100, 12000};
    Idol rose = {"rose", 50, 100, 100, 10000}; // Nueva idol para HU-09
    Idol *p = &jennie;
    
    printf("--- HU-02 a HU-08 (Pruebas anteriores) ---\n");
    printf("Con punto: %d\n", jennie.fans);
    printf("Con desreferencia: %d\n", (*p).fans);
    printf("Con flecha: %d\n", p->fans);
    mostrar(&jennie);
    
    // HU-09: Pruebas de colaboración
    printf("\n--- HU-09: Colaboracion segura ---\n");
    printf("Colaboracion consigo misma (debe ser 0): %d\n", colaboracion(&jennie, &jennie));
    printf("Colaboracion con NULL (debe ser 0): %d\n", colaboracion(NULL, &rose));
    printf("Colaboracion valida (debe ser 1): %d\n", colaboracion(&jennie, &rose));
    
    printf("\nDatos de Jennie:\n"); mostrar(&jennie);
    printf("Datos de Rose:\n"); mostrar(&rose);
    
    return 0;
}