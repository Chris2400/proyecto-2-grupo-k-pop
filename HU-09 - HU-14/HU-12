#include <stdio.h>

// HU-12: Estructura Cancion (Debe ir ANTES de Idol)
typedef struct {
    char nombre[30];
    int bonus;
    int vigencia;
} Cancion;

typedef struct {
    char nombre[30];
    int popularidad;
    int energia;
    int energia_max;
    int fans;
} Idol;

int limitar(int valor, int minimo, int maximo) {
    if (valor < minimo) return minimo;
    if (valor > maximo) return maximo;
    return valor;
}

void mostrar(const Idol *i) {
    if (i == NULL) return;
    printf("Nombre: %s | Popularidad: %d | Energia: %d/%d | Fans: %d\n", 
           i->nombre, i->popularidad, i->energia, i->energia_max, i->fans);
}

void ensayar(Idol *i) {
    if (i == NULL) return;
    i->popularidad += 5;
    i->energia = limitar(i->energia - 20, 0, i->energia_max);
}

int main() {
    Idol jennie = {"jennie", 50, 100, 100, 12000};
    Idol rose = {"rose", 50, 100, 100, 10000};
    
    // HU-12: Arreglo de canciones en main
    Cancion discos[2] = {{"Starlight", 10, 3}, {"Nova", 5, 6}};
    
    printf("--- HU-12: Canciones creadas ---\n");
    printf("Cancion 0: %s (Bonus: %d, Vigencia: %d)\n", discos[0].nombre, discos[0].bonus, discos[0].vigencia);
    printf("Cancion 1: %s (Bonus: %d, Vigencia: %d)\n", discos[1].nombre, discos[1].bonus, discos[1].vigencia);
    
    return 0;
}