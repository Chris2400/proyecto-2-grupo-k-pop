#include <stdio.h>

typedef struct {
    char nombre[30];
    int bonus;
    int vigencia;
} Cancion;

// HU-13: Idol con canción opcional
typedef struct {
    char nombre[30];
    int popularidad;
    int energia;
    int energia_max;
    int fans;
    Cancion *cancion; // <--- Nuevo campo
} Idol;

int limitar(int valor, int minimo, int maximo) {
    if (valor < minimo) return minimo;
    if (valor > maximo) return maximo;
    return valor;
}

void mostrar(const Idol *i) {
    if (i == NULL) return;
    printf("Nombre: %s | Popularidad: %d | Energia: %d/%d | Fans: %d\n", 
           i->nombre, i->popularidad, i->energia, i->energia_max, i->fans);
}

void ensayar(Idol *i) {
    if (i == NULL) return;
    i->popularidad += 5;
    i->energia = limitar(i->energia - 20, 0, i->energia_max);
}

int main() {
    // HU-13: Todos los inicializadores terminan en NULL
    Idol jennie = {"jennie", 50, 100, 100, 12000, NULL};
    Idol rose = {"rose", 50, 100, 100, 10000, NULL};
    
    Cancion discos[2] = {{"Starlight", 10, 3}, {"Nova", 5, 6}};
    
    printf("--- HU-13: Idol con cancion opcional ---\n");
    printf("Jennie tiene cancion?: %s\n", jennie.cancion == NULL ? "No" : "Si");
    printf("Rose tiene cancion?: %s\n", rose.cancion == NULL ? "No" : "Si");
    
    // Las funciones anteriores siguen funcionando
    mostrar(&jennie);
    ensayar(&jennie);
    mostrar(&jennie);
    
    return 0;
}