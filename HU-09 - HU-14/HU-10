#include <stdio.h>

typedef struct {
    char nombre[30];
    int popularidad;
    int energia;
    int energia_max;
    int fans;
} Idol;

int limitar(int valor, int minimo, int maximo) {
    if (valor < minimo) return minimo;
    if (valor > maximo) return maximo;
    return valor;
}

void mostrar(const Idol *i) {
    if (i == NULL) return;
    printf("Nombre: %s | Popularidad: %d | Energia: %d/%d | Fans: %d\n", 
           i->nombre, i->popularidad, i->energia, i->energia_max, i->fans);
}

void ensayar(Idol *i) {
    if (i == NULL) return;
    i->popularidad += 5;
    i->energia = limitar(i->energia - 20, 0, i->energia_max);
}

void descansar(Idol *i) {
    if (i == NULL) return;
    i->energia = limitar(i->energia + 30, 0, i->energia_max);
}

int esta_activa(const Idol *i) {
    if (i == NULL) return 0;
    return i->energia > 0 ? 1 : 0;
}

int colaboracion(Idol *a, Idol *b) {
    if (a == NULL || b == NULL || a == b) return 0;
    a->popularidad += 10;
    a->energia = limitar(a->energia - 15, 0, a->energia_max);
    b->popularidad += 10;
    b->energia = limitar(b->energia - 15, 0, b->energia_max);
    printf("Colaboracion exitosa entre %s y %s.\n", a->nombre, b->nombre);
    return 1;
}

int main() {
    Idol jennie = {"jennie", 50, 100, 100, 12000};
    Idol rose = {"rose", 50, 100, 100, 10000};
    
    printf("--- HU-09: Colaboracion (Prueba rapida) ---\n");
    colaboracion(&jennie, &rose);
    
    // HU-10: Dinámica por turnos
    printf("\n--- HU-10: Dinamica por turnos ---\n");
    
    // Reiniciamos energías para la prueba (opcional, para que dure el ciclo)
    jennie.energia = 50; rose.energia = 50;
    
    Idol *turno = &jennie;
    Idol *otra = &rose;
    Idol *temp; // Variable temporal para intercambiar apuntadores
    
    while (esta_activa(turno) && esta_activa(otra)) {
        ensayar(turno);
        printf("%s ensayo. Energia de %s: %d\n", turno->nombre, turno->nombre, turno->energia);
        
        // Intercambio de apuntadores (NO copiamos structs)
        temp = turno;
        turno = otra;
        otra = temp;
    }
    
    printf("\nEl ciclo termino. %s conserva energia.\n", esta_activa(turno) ? turno->nombre : otra->nombre);
    
    return 0;
}