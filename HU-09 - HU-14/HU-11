#include <stdio.h>

typedef struct {
    char nombre[30];
    int popularidad;
    int energia;
    int energia_max;
    int fans;
} Idol;

int limitar(int valor, int minimo, int maximo) {
    if (valor < minimo) return minimo;
    if (valor > maximo) return maximo;
    return valor;
}

void mostrar(const Idol *i) {
    if (i == NULL) return;
    printf("Nombre: %s | Popularidad: %d | Energia: %d/%d | Fans: %d\n", 
           i->nombre, i->popularidad, i->energia, i->energia_max, i->fans);
}

void ensayar(Idol *i) {
    if (i == NULL) return;
    i->popularidad += 5;
    i->energia = limitar(i->energia - 20, 0, i->energia_max);
}

int esta_activa(const Idol *i) {
    if (i == NULL) return 0;
    return i->energia > 0 ? 1 : 0;
}

int main() {
    Idol jennie = {"jennie", 50, 100, 100, 12000};
    Idol rose = {"rose", 50, 100, 100, 10000};
    
    Idol *turno = &jennie;
    Idol *otra = &rose;
    Idol *temp;
    
    // HU-11: Explicación visual de intercambio de apuntadores
    printf("--- HU-11: Intercambio de apuntadores ---\n");
    printf("ANTES:\n");
    printf("turno apunta a: %p (%s)\n", (void *)turno, turno->nombre);
    printf("otra apunta a:  %p (%s)\n", (void *)otra, otra->nombre);
    
    // Intercambio
    temp = turno;
    turno = otra;
    otra = temp;
    
    printf("\nDESPUES:\n");
    printf("turno apunta a: %p (%s)\n", (void *)turno, turno->nombre);
    printf("otra apunta a:  %p (%s)\n", (void *)otra, otra->nombre);
    printf("(Nota: Los structs jennie y rose NO se movieron de memoria, solo las flechas)\n");
    
    return 0;
}